{
  "manifest_version": 3,
  "name": "PVE Homelab: service tabs",
  "version": "2.1",
  "description": "Services open as tabs next to the menu; a dock on every page switches between them.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "show-dock": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Dock: menu and open services"
    }
  }
}
