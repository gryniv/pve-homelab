[Unit]
Description=PVE Homelab kiosk on seat %i
After=pve-homelab.service systemd-user-sessions.service
Wants=pve-homelab.service

[Service]
# TTYPath and Conflicts=getty@ttyN come from the per-seat drop-in written by install.sh
User=pvehomelab
PAMName=login
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=%I
UtmpMode=user
ExecStart=/opt/pve-homelab/kiosk/kiosk.sh %i
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
