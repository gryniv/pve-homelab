[Unit]
Description=PVE Homelab backend (local console: sign-in, dashboard, launcher)
After=pve-cluster.service pveproxy.service network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONPATH=/opt/pve-homelab/backend
ExecStartPre=-/sbin/modprobe i2c-dev
ExecStart=/usr/bin/python3 -m pvehomelab
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
