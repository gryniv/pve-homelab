[Unit]
Description=PVE Seat kiosk на місці %i
After=pve-seat.service systemd-user-sessions.service
Wants=pve-seat.service

[Service]
# TTYPath and Conflicts=getty@ttyN come from the per-seat drop-in written by install.sh
User=pveseat
PAMName=login
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=%I
UtmpMode=user
ExecStart=/opt/pve-seat/kiosk/kiosk.sh %i
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
