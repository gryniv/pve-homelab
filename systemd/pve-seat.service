[Unit]
Description=PVE Seat backend (екран хоста: вхід, панель, запуск систем)
After=pve-cluster.service pveproxy.service network-online.target
Wants=network-online.target

[Service]
Environment=PYTHONPATH=/opt/pve-seat/backend
ExecStartPre=-/sbin/modprobe i2c-dev
ExecStart=/usr/bin/python3 -m pveseat
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
